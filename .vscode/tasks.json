{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build HAP (debug)",
			"type": "shell",
			"command": "hvigorw",
			"args": [
				"assembleHap",
				"--mode",
				"module",
				"-p",
				"product=default",
				"-p",
				"buildMode=debug",
				"--no-daemon"
			],
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		}
	]
}